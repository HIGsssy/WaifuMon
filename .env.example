# Discord
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-id
# Optional: register commands guild-scoped for instant iteration
DISCORD_GUILD_ID=

# Postgres (used by the compose postgres service; DATABASE_URL is derived in compose)
POSTGRES_USER=waifumon
POSTGRES_PASSWORD=change-me
POSTGRES_DB=waifumon

# For running the bot outside compose (npm run dev):
DATABASE_URL=postgres://waifumon:change-me@localhost:5432/waifumon

# Paths (defaults shown; compose overrides these to /app/*)
ASSETS_DIR=./assets
CONTENT_DIR=./content

# Gameplay
DAILY_TIMEZONE=UTC
LOG_LEVEL=info

# Internal admin web panel (docs/admin-web.md).
# Disabled by default. When enabled, ADMIN_WEB_TOKEN is REQUIRED or startup
# fails. Generate one with: openssl rand -hex 32
ADMIN_WEB_ENABLED=false
ADMIN_WEB_PORT=3111
ADMIN_WEB_TOKEN=

# The bind INSIDE the process. Use 127.0.0.1 when running the bot directly on
# the host (npm run dev / npm start), and reach it via an SSH tunnel:
#   ssh -L 3111:127.0.0.1:3111 user@server
# Under Docker this MUST be 0.0.0.0 — loopback inside a container is its own
# network namespace and is unreachable from outside it.
ADMIN_WEB_HOST=127.0.0.1

# Docker only: the host address the port is published on. This is the real
# security boundary, not ADMIN_WEB_HOST above.
#   127.0.0.1      host loopback only — reach it with an SSH tunnel (default)
#   100.x.y.z      the host's own Tailscale IP — reachable across your tailnet
#   0.0.0.0        every interface, including public. Do NOT use: Docker
#                  publishes ports ahead of ufw/iptables, so a firewall will
#                  not protect it.
ADMIN_WEB_PUBLISH_HOST=127.0.0.1

# Internal Platform REST API (/api/v1/…).
# A second HTTP surface in the same process, exposing the game service layer to
# non-Discord clients (dev tools, future Player Portal). Disabled by default.
# When enabled, PLATFORM_API_TOKEN is REQUIRED or startup fails.
# Generate one with: openssl rand -hex 32
#
# Every request needs `Authorization: Bearer $PLATFORM_API_TOKEN`, except
# /health, /ready, /api/v1/docs and /api/v1/openapi.json.
#
# NOTE: v1 API mutations do NOT emit Game Events — actions taken through the
# API do not appear in the Activity Feed or update Trainer Profiles.
PLATFORM_API_ENABLED=false
PLATFORM_API_PORT=3120
PLATFORM_API_TOKEN=

# The bind INSIDE the process. Use 127.0.0.1 when running the bot directly on
# the host (npm run dev / npm start), and reach it via an SSH tunnel:
#   ssh -L 3120:127.0.0.1:3120 user@server
# Under Docker this MUST be 0.0.0.0 — loopback inside a container is its own
# network namespace and is unreachable from outside it. The process logs a
# warning whenever this is neither loopback (127.0.0.0/8) nor Tailscale
# (100.64.0.0/10), which is expected and harmless under Docker.
PLATFORM_API_HOST=127.0.0.1

# Docker only: the host address the port is published on. This is the real
# security boundary, not PLATFORM_API_HOST above. Same rules as
# ADMIN_WEB_PUBLISH_HOST — never 0.0.0.0.
PLATFORM_API_PUBLISH_HOST=127.0.0.1
