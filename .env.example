# Discord
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-id
# Optional: register commands guild-scoped for instant iteration
DISCORD_GUILD_ID=

# Postgres (used by the compose postgres service; DATABASE_URL is derived in compose)
POSTGRES_USER=waifumon
POSTGRES_PASSWORD=change-me
POSTGRES_DB=waifumon

# For running the bot outside compose (npm run dev):
DATABASE_URL=postgres://waifumon:change-me@localhost:5432/waifumon

# Paths (defaults shown; compose overrides these to /app/*)
ASSETS_DIR=./assets
CONTENT_DIR=./content

# Gameplay
DAILY_TIMEZONE=UTC
LOG_LEVEL=info
