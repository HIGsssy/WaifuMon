# Discord
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-id
# Optional: register commands guild-scoped for instant iteration
DISCORD_GUILD_ID=

# Postgres (used by the compose postgres service; DATABASE_URL is derived in compose)
POSTGRES_USER=waifumon
POSTGRES_PASSWORD=change-me
POSTGRES_DB=waifumon

# For running the bot outside compose (npm run dev):
DATABASE_URL=postgres://waifumon:change-me@localhost:5432/waifumon

# Paths (defaults shown; compose overrides these to /app/*)
ASSETS_DIR=./assets
CONTENT_DIR=./content

# Gameplay
DAILY_TIMEZONE=UTC
LOG_LEVEL=info

# Internal admin web panel (docs/admin-web.md).
# Disabled by default. When enabled, ADMIN_WEB_TOKEN is REQUIRED or startup
# fails. Generate one with: openssl rand -hex 32
ADMIN_WEB_ENABLED=false
ADMIN_WEB_PORT=3111
ADMIN_WEB_TOKEN=

# The bind INSIDE the process. Use 127.0.0.1 when running the bot directly on
# the host (npm run dev / npm start), and reach it via an SSH tunnel:
#   ssh -L 3111:127.0.0.1:3111 user@server
# Under Docker this MUST be 0.0.0.0 — loopback inside a container is its own
# network namespace and is unreachable from outside it.
ADMIN_WEB_HOST=127.0.0.1

# Docker only: the host address the port is published on. This is the real
# security boundary, not ADMIN_WEB_HOST above.
#   127.0.0.1      host loopback only — reach it with an SSH tunnel (default)
#   100.x.y.z      the host's own Tailscale IP — reachable across your tailnet
#   0.0.0.0        every interface, including public. Do NOT use: Docker
#                  publishes ports ahead of ufw/iptables, so a firewall will
#                  not protect it.
ADMIN_WEB_PUBLISH_HOST=127.0.0.1

# Internal Platform REST API (/api/v1/…).
# A second HTTP surface in the same process, exposing the game service layer to
# non-Discord clients (dev tools, future Player Portal). Disabled by default.
# When enabled, PLATFORM_API_TOKEN is REQUIRED or startup fails.
# Generate one with: openssl rand -hex 32
#
# Every request needs `Authorization: Bearer $PLATFORM_API_TOKEN`, except
# /health, /ready, /api/v1/docs and /api/v1/openapi.json.
#
# NOTE: v1 API mutations do NOT emit Game Events — actions taken through the
# API do not appear in the Activity Feed or update Trainer Profiles.
PLATFORM_API_ENABLED=false
PLATFORM_API_PORT=3120
PLATFORM_API_TOKEN=

# Rendered card images: GET /api/v1/cards/species/:slug and
# GET /api/v1/players/:id/collection/owned/:waifuId/card
#
# Composes assets/cardart/ + character artwork into a 1000x1400 WebP, cached
# under assets/.card-cache/. Requires PLATFORM_API_ENABLED as well — the routes
# live on the Platform API.
#
# Off by default: rasterizing is the most expensive thing this process does, and
# a flag that ships on cannot be rolled out. Turn it on in development.
#
# TEMPORARY rollout gating, not permanent architecture — this variable is
# removed once the renderer is stable in production.
#
# Warm the cache ahead of first request:  npm run cards:warm
# Warm one player's owned cards:          npm run cards:warm -- --player 12
# Warm the owned back catalogue:          npm run cards:warm -- --all-players
# Reclaim orphaned renders:               npm run cards:gc -- --dry-run
CARD_RENDERER_ENABLED=false

# Worker threads that draw card masters. Drawing one blocks its thread for
# ~750ms of synchronous SVG rasterization, so it runs off the main thread and
# this is the ceiling on concurrent cold renders. 2 is measured, not derived
# from the core count -- each thread holds a full decoded card, and containers
# rarely have the cores the host advertises. 0 renders in-process (identical
# output, event loop blocks again).
CARD_RENDER_WORKERS=2

# PRODUCTION SIZING NOTE (Ryzen mini-PC, 16 GB, shared with Postgres + gateway):
#   start at CARD_RENDER_WORKERS=1 and only raise it after measuring on the real
#   node. Responsiveness is the goal, not render throughput: cold masters are
#   rare once warming is in place, and Discord/API latency during a render burst
#   is what a player actually notices. Benchmark 1 vs 2 there -- peak RSS, cold
#   render wall time, event-loop delay, Discord and API responsiveness -- and do
#   not go to 3+ without those numbers. Never derive this from the core count.

# Owned cards warmed at once by a BACKGROUND warm (warm-on-capture, and the
# self-healing warm behind a collection listing). 1 composes correctly with a
# single render worker: a cold master someone is waiting for queues behind at
# most one warm card. Raise `cards:warm --concurrency` instead when running an
# operator job -- this knob is for the live process.
CARD_WARM_CONCURRENCY=1

# Whether listing a player's collection triggers a background warm of their
# owned cards. This is the self-HEALING path, not the primary one: captures warm
# their own card, and `npm run cards:warm -- --all-players` covers the back
# catalogue. Turn it off to take warming out of the picture on a small node
# without giving up card rendering.
CARD_WARM_ON_COLLECTION=true

# The bind INSIDE the process. Use 127.0.0.1 when running the bot directly on
# the host (npm run dev / npm start), and reach it via an SSH tunnel:
#   ssh -L 3120:127.0.0.1:3120 user@server
# Under Docker this MUST be 0.0.0.0 — loopback inside a container is its own
# network namespace and is unreachable from outside it. The process logs a
# warning whenever this is neither loopback (127.0.0.0/8) nor Tailscale
# (100.64.0.0/10), which is expected and harmless under Docker.
PLATFORM_API_HOST=127.0.0.1

# Docker only: the host address the port is published on. This is the real
# security boundary, not PLATFORM_API_HOST above. Same rules as
# ADMIN_WEB_PUBLISH_HOST — never 0.0.0.0.
PLATFORM_API_PUBLISH_HOST=127.0.0.1

# How CLIENTS reach the API: the base URL advertised in the OpenAPI document,
# and therefore the one Swagger UI's "Try it out" calls. This is a third,
# separate concept from the two above:
#
#   PLATFORM_API_HOST         where the process listens        (inside)
#   PLATFORM_API_PUBLISH_HOST where Docker publishes the port  (host boundary)
#   PLATFORM_API_PUBLIC_URL   how clients dial it              (advertised)
#
# Optional. Leave it blank and the URL is derived from the bind — with a
# wildcard bind (0.0.0.0, as Docker requires) falling back to
# http://127.0.0.1:$PLATFORM_API_PORT, since 0.0.0.0 is a listening address no
# browser can route to. Set it whenever clients reach the API at some other
# address; it must be absolute, http(s), and never a wildcard.
#
#   http://127.0.0.1:3120         local dev, and Docker published to loopback
#   http://100.x.y.z:3120         Tailscale (the host's tailnet IP)
#   https://api.waifumon.com      behind a TLS reverse proxy
PLATFORM_API_PUBLIC_URL=

# Public Portal web endpoint (Nginx reverse proxy + compiled Vite SPA).
# Docker Compose publishes this endpoint to host loopback by default so a
# Cloudflare Tunnel running on the host can connect to it without making the
# port directly public.
PORTAL_WEB_PUBLISH_HOST=127.0.0.1
PORTAL_WEB_PORT=3130

# The proto the Portal web proxy reports to the Platform API. Keep `http` for
# direct local testing. Set `https` when Cloudflare terminates TLS and tunnels
# to http://127.0.0.1:$PORTAL_WEB_PORT.
PORTAL_FORWARDED_PROTO=http

# Production Portal build-time values. Do NOT set VITE_PLATFORM_API_TOKEN here:
# production must not embed the Platform API master bearer token in browser JS.
VITE_DEFAULT_PLAYER_ID=
VITE_DEFAULT_DISCORD_GUILD_ID=
VITE_DEFAULT_DISCORD_USER_ID=
VITE_API_TIMEOUT_MS=
VITE_IMAGE_PROVIDERS=
VITE_ASSET_CDN_URL=
