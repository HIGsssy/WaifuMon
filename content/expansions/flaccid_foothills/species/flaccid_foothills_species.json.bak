      "expansion",
      "region_exclusive"
    ],
    "contentRating": "suggestive",
    "affinity": "submissive",
    "card": {
      "subtitle": "Bloom-Kept Daughter",
      "ability": {
        "name": "Clover Thirst",
        "text": "Every patch she beds down in flowers by morning. She blushes like it's a secret."
      },
      "flavorQuote": "The meadow asked me to keep you. It didn't say for how long.",
      "artist": "Whistler"
    },
