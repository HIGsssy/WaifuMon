# ─────────────────────────────────────────────────────────────────────────────
#  Waifumon Player Portal — development configuration
#
#  Copy to `.env.local` and fill in. Every value here is baked into the client
#  bundle at build time; nothing in this file is a secret you can keep.
#
#  ⚠ DEV ONLY. The Vite dev server may ship a shared bearer token to the
#    browser on purpose (see VITE_PLATFORM_API_TOKEN below). Production builds
#    are served by the repo-level Docker/Nginx path and must not set that token.
#    See docs/portal.md.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL the Axios client prefixes onto every request.
# Leave as `/api` in dev: the Vite dev server proxies `/api/*` to the Platform
# API, so requests are same-origin and CORS never applies.
VITE_PLATFORM_API_URL=/api

# Where the Vite dev-server proxy forwards `/api`, `/ready` and `/health`.
# Must match PLATFORM_API_HOST / PLATFORM_API_PORT on the bot side.
VITE_PLATFORM_API_PROXY_TARGET=http://127.0.0.1:3120

# ⚠ The Platform API's shared bearer token, matching PLATFORM_API_TOKEN in the
#   bot's .env. It is embedded in the client bundle and readable by anyone who
#   can load the page. This is acceptable only for local development and must
#   not be set for the production Portal image.
VITE_PLATFORM_API_TOKEN=

# Optional. Request timeout in milliseconds; defaults to 30000.
# Raise it if the API sits behind a genuinely slow link (Tailscale, VPN) and you
# see "took too long to answer". If that happens while artwork is loading, the
# fix is `npm run assets:thumbs`, not a bigger number here — see docs/portal.md.
# VITE_API_TIMEOUT_MS=30000

# ⚠ NOT used by `npm run dev`. A dev build asks who you are on a "Developer
#   login" screen — enter a Discord user id, the Portal resolves it through
#   GET /api/v1/players/lookup, and remembers the choice in this browser. Switch
#   testers from the header's "Switch player" button; no env edit, no restart.
#
# This value is the acting player for a *non-dev* build (`npm run build`), which
# still has no login screen: an internal player id (an integer), not a Discord
# snowflake, resolved once at startup via GET /api/v1/players/{id}.
VITE_DEFAULT_PLAYER_ID=

# Optional. Pre-fills the developer login screen's server field, so signing in
# as a tester is one snowflake rather than two. Also surfaced on the diagnostics
# page, and used to label the session when the API does not carry the value.
VITE_DEFAULT_DISCORD_GUILD_ID=

# Optional, presentation only. Pre-fills the developer login screen's user field
# on a browser that has never signed in.
VITE_DEFAULT_DISCORD_USER_ID=

# Optional. Filesystem path (relative to portal/) served at /dev-assets/*.
# Defaults to the bot repo's own assets folder — one source of truth, no copy.
# VITE_DEV_ASSETS_PATH=../assets

# Optional. Comma-separated image-provider chain for the resolver (plan §12).
# Providers are tried in order; the first non-fallback URL wins. Known ids:
#   artworkApi      — authenticated /api/v1/assets and owned-artwork routes
#   cardApi         — authenticated rendered-card routes
#   localDevAssets  — development-only /dev-assets/<imagePath> fallback
#   silhouette      — themed placeholder; never fails, always last
# Defaults to `apiSuppliedUrl,cardApi,artworkApi,localDevAssets,silhouette`.
# VITE_IMAGE_PROVIDERS=artworkApi,localDevAssets,silhouette
