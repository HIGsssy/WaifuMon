# ─────────────────────────────────────────────────────────────────────────────
#  Waifumon Player Portal — development configuration
#
#  Copy to `.env.local` and fill in. Every value here is baked into the client
#  bundle at build time; nothing in this file is a secret you can keep.
#
#  ⚠ DEV ONLY. The Portal has no authentication. It ships a shared bearer token
#    to the browser on purpose (see VITE_PLATFORM_API_TOKEN below) and there is
#    no production build path in v1. Do not expose the dev server beyond your
#    machine or LAN. See docs/portal.md.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL the Axios client prefixes onto every request.
# Leave as `/api` in dev: the Vite dev server proxies `/api/*` to the Platform
# API, so requests are same-origin and CORS never applies.
VITE_PLATFORM_API_URL=/api

# Where the Vite dev-server proxy forwards `/api`, `/ready` and `/health`.
# Must match PLATFORM_API_HOST / PLATFORM_API_PORT on the bot side.
VITE_PLATFORM_API_PROXY_TARGET=http://127.0.0.1:3120

# ⚠ The Platform API's shared bearer token, matching PLATFORM_API_TOKEN in the
#   bot's .env. It is embedded in the client bundle and readable by anyone who
#   can load the page. This is acceptable only because v1 is local-dev-only.
VITE_PLATFORM_API_TOKEN=

# The acting player. Internal player id (an integer), not a Discord snowflake.
# Resolved once at startup via GET /api/v1/players/{id}. Without it — or if it
# does not resolve — the Portal shows the /select-player fallback screen.
# Changing the acting player is an edit here plus a reload; there is no runtime
# switcher in v1 (plan §25.2).
VITE_DEFAULT_PLAYER_ID=

# Optional, presentation only — surfaced on the diagnostics page and used to
# label the session when the API does not carry the value.
VITE_DEFAULT_DISCORD_GUILD_ID=
VITE_DEFAULT_DISCORD_USER_ID=

# Optional. Filesystem path (relative to portal/) served at /dev-assets/*.
# Defaults to the bot repo's own assets folder — one source of truth, no copy.
# VITE_DEV_ASSETS_PATH=../assets

# Optional. Comma-separated image-provider chain for the resolver (plan §12).
# Providers are tried in order; the first non-fallback URL wins. Known ids:
#   localDevAssets  — /dev-assets/<imagePath>
#   silhouette      — themed placeholder; never fails, always last
# Defaults to `localDevAssets,silhouette`.
# VITE_IMAGE_PROVIDERS=localDevAssets,silhouette
