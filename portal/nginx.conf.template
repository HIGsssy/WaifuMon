server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  server_tokens off;

  # No `add_header` at this level on purpose — see security-headers.conf. A
  # server-level set here would be silently dropped by every location that
  # defines any add_header of its own, which is most of them.

  location ~ /\.(?!well-known(?:/|$)) {
    deny all;
    access_log off;
    log_not_found off;
  }

  location ~* \.map$ {
    return 404;
  }

  # Liveness only. The handler returns `{"status":"ok"}` and probes nothing —
  # no component names, no versions, no bind. Safe to answer anonymously, and
  # it is what a tunnel health check in front of the Portal should target.
  location = /health {
    include /etc/nginx/security-headers.conf;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    proxy_pass ${PORTAL_API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto ${PORTAL_FORWARDED_PROTO};
  }

  # /ready is deliberately NOT proxied.
  #
  # Its body names internal components and their failure detail: the database
  # ping result (including the driver's error message), the Discord gateway
  # state, the loaded content counts, and the Platform API's effective bind and
  # port. That is a diagnostic report for an operator, not something to hand an
  # anonymous visitor on a tunnel-exposed origin — it maps the deployment and
  # turns a database outage into a public signal.
  #
  # It is not removed, only unpublished. `/ready` still answers, unauthenticated
  # and unchanged, everywhere it is actually used:
  #   - container-internally at http://waifumon-bot:3120/ready
  #   - on the host at http://127.0.0.1:3120/ready (loopback publication)
  #   - in dev, through Vite's own proxy entry, which is what the developer
  #     diagnostics page uses — that page is dev-only and Vite drops it from
  #     production builds, so nothing in the shipped bundle asks for this.
  #
  # An explicit 404 rather than falling through to the SPA: a fallthrough would
  # answer 200 with index.html and make a broken probe look like a healthy one.
  location = /ready {
    include /etc/nginx/security-headers.conf;
    return 404;
  }

  # /metrics is deliberately NOT proxied, for the same reasons as /ready and
  # more of them.
  #
  # It reports process RSS and heap, event-loop delay percentiles, per-route
  # request counts and latency, Postgres pool saturation, and card-renderer
  # queue depth. That is a live capacity and load profile of the deployment:
  # enough to infer traffic volume, to see which routes are slow, and to tell
  # when the node is close to its limit — which is exactly the information that
  # makes a deployment worth pushing on, and none of which the Portal reads.
  #
  # Unpublished rather than removed. `/metrics` still answers, with the bearer
  # token, everywhere it is used:
  #   - container-internally at http://waifumon-bot:3120/metrics
  #   - on the host at http://127.0.0.1:3120/metrics (loopback publication)
  #
  # This is the second of two layers, not the only one. The route itself demands
  # the Platform API bearer token and refuses a Portal session with 403, so the
  # endpoint is closed even to a logged-in player who reaches it by some other
  # path. This rule is what keeps it off the public origin regardless.
  #
  # `^~` rather than `=` so it covers `/metrics/reset` as well as `/metrics`,
  # and so a future subpath is closed by default rather than by being
  # remembered. The prefix shadows no SPA route — the Portal has no page under
  # /metrics.
  location ^~ /metrics {
    include /etc/nginx/security-headers.conf;
    return 404;
  }

  # The API's own documentation surface is not published to the internet.
  #
  # `@fastify/swagger` puts Swagger UI at /api/v1/docs and the spec at
  # /api/v1/openapi.json, and the Platform API's auth hook allow-lists both so
  # an operator can read them without a token. That is right for a loopback
  # port and wrong for a Cloudflare-fronted origin: together they publish every
  # route, parameter and schema the backend has, which is a map for anyone
  # deciding where to push. No credential leaks — calling an operation still
  # needs the bearer token — but the reconnaissance value is free, and nothing
  # in the Portal reads either path.
  #
  # Same treatment as /ready, and unpublished rather than removed: both still
  # answer on the loopback Platform API (127.0.0.1:3120) and container-side,
  # which is where administration and development already reach them.
  #
  # Placement matters more than it looks. `location ^~ /api` below suppresses
  # regex-location evaluation for everything under /api, so a `~` rule could
  # never fire here. These two win on nginx's own precedence instead: an exact
  # `=` match outranks every prefix, and `^~ /api/v1/docs` is a longer prefix
  # than `^~ /api`. That also closes the path-variation routes into them —
  # nginx decodes %XX, collapses `.`/`..` and merges duplicate slashes before
  # it matches a location, so /api/v1/%64ocs, /api/v1/./docs and /api//v1/docs
  # all normalise into these rules rather than around them. The prefix form
  # covers the whole Swagger UI asset subtree (/api/v1/docs/*), not just the
  # entry point; no real endpoint begins with "doc", so it shadows nothing.
  location = /api/v1/openapi.json {
    include /etc/nginx/security-headers.conf;
    return 404;
  }

  location ^~ /api/v1/docs {
    include /etc/nginx/security-headers.conf;
    return 404;
  }

  location ^~ /auth/ {
    include /etc/nginx/security-headers.conf;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    proxy_pass ${PORTAL_API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto ${PORTAL_FORWARDED_PROTO};
  }

  # World Encounter import (preview + apply) carries a complete encounter
  # export, which outgrows nginx's 1 MB default body limit as the library grows.
  # The API caps these two routes at 8 MiB (ENCOUNTER_IMPORT_BODY_LIMIT_BYTES in
  # src/api/routes/v1/admin/encounterPromotion.ts); this is set a little above
  # that so the API's own JSON 413, which names the limit, is what a caller
  # sees rather than nginx's HTML page. Every other /api path keeps the default.
  # Otherwise identical to the /api proxy below.
  location ^~ /api/v1/admin/encounters/import/ {
    include /etc/nginx/security-headers.conf;
    client_max_body_size 9m;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    proxy_pass ${PORTAL_API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto ${PORTAL_FORWARDED_PROTO};
  }

  # Managed artwork (docs/managed-artwork.md): an upload's body is the image
  # itself, up to 8 MiB (ARTWORK_UPLOAD_MAX_BYTES in
  # src/modules/artworkAssets/imageInspection.ts). Set a little above that for
  # the same reason as the import routes: the API's own JSON 413 names the
  # limit. Otherwise identical to the /api proxy below.
  location ^~ /api/v1/admin/artwork/ {
    include /etc/nginx/security-headers.conf;
    client_max_body_size 9m;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    proxy_pass ${PORTAL_API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto ${PORTAL_FORWARDED_PROTO};
  }

  # Boss artwork (docs/boss-management.md): an upload's body is the image,
  # up to 8 MiB (ARTWORK_UPLOAD_MAX_BYTES), on its own path under Boss
  # Management rather than /api/v1/admin/artwork/. Same reasoning and the same
  # ceiling as the managed-artwork block above.
  #
  # The prefix is the uploads' own path and has NO trailing slash, on purpose.
  # For a proxy_pass location whose prefix ends in "/", nginx answers a request
  # for that prefix *without* the slash with a 301 to the slashed URL. Shipped
  # boss artwork is served at exactly /api/v1/admin/bosses/artwork?path=…, so a
  # location named /api/v1/admin/bosses/artwork/ redirected every one of those
  # requests to a URL the API did not serve, and every existing boss picture
  # read as missing in the Portal. Never name a slash-terminated location whose
  # slash-less form is a real API route.
  location ^~ /api/v1/admin/bosses/artwork/assets {
    include /etc/nginx/security-headers.conf;
    client_max_body_size 9m;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    proxy_pass ${PORTAL_API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto ${PORTAL_FORWARDED_PROTO};
  }

  # Boss import (plan + apply) carries a whole roster export: every boss's
  # prose and schedule. The API caps these two routes at 2 MiB
  # (BOSS_IMPORT_BODY_LIMIT_BYTES in src/api/routes/v1/admin/bosses.ts); set a
  # little above that so the API's JSON 413 is what a caller sees.
  location ^~ /api/v1/admin/bosses/import/ {
    include /etc/nginx/security-headers.conf;
    client_max_body_size 3m;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    proxy_pass ${PORTAL_API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto ${PORTAL_FORWARDED_PROTO};
  }

  # Dungeon JSON plan/apply bodies include package and decision fields.
  # Keep this aligned with Fastify's 2 MiB import limit only.
  location ^~ /api/v1/admin/dungeons/import/ {
    include /etc/nginx/security-headers.conf;
    client_max_body_size 2m;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    proxy_pass ${PORTAL_API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto ${PORTAL_FORWARDED_PROTO};
  }

  location ^~ /api {
    include /etc/nginx/security-headers.conf;
    # Strip the upstream's copies before adding ours. @fastify/helmet sends
    # X-Frame-Options: SAMEORIGIN and Referrer-Policy: no-referrer, which
    # conflict with the values above; without this the browser receives two of
    # each and resolves them by its own rules rather than ours (Referrer-Policy
    # takes the last valid token, so the upstream would silently win).
    # X-Content-Type-Options agrees on `nosniff` and is stripped only so the
    # header is not sent twice.
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    proxy_pass ${PORTAL_API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto ${PORTAL_FORWARDED_PROTO};
  }

  location /assets/ {
    include /etc/nginx/security-headers.conf;
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
  }

  location = /index.html {
    include /etc/nginx/security-headers.conf;
    try_files $uri =404;
    add_header Cache-Control "no-cache" always;
  }

  location / {
    include /etc/nginx/security-headers.conf;
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-cache" always;
  }
}
