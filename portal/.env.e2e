# Build-time configuration for the Playwright suite.
#
# Committed on purpose and holds no secret: the end-to-end tests stub every
# `/api` response in the browser, so this token is never sent anywhere. It
# exists only so the built bundle has a value to attach.
#
# `vite build --mode e2e` reads this file. The resulting bundle is a production
# build in every other respect — `import.meta.env.DEV` is false, so the
# diagnostics page is excluded exactly as it is in a real build.
VITE_PLATFORM_API_URL=/api
VITE_PLATFORM_API_TOKEN=e2e-not-a-real-token
VITE_DEFAULT_PLAYER_ID=1
