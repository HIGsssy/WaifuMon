{
  "name": "waifumon-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Waifumon — standalone Discord collection game bot (Milestone 1: Standalone Postgres Foundation)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "appearances:sync": "tsx src/tools/syncAppearances.ts",
    "assets:thumbs": "npm --prefix portal run assets:thumbs",
    "content:prepare": "npm run appearances:sync && npm run assets:thumbs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "discord.js": "^14.16.3",
    "drizzle-orm": "^0.38.3",
    "fast-xml-parser": "^5.10.1",
    "fastify": "^5.11.0",
    "fastify-type-provider-zod": "^4.0.2",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "sharp": "^0.35.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.16.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
